# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Data: local dev files stay out of git, except small fixtures
data/*
!data/fixtures/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Frontend
node_modules/
dist/
.env*
!.env.example
!.env.production

# osmnx HTTP cache
cache/

# Editors, OS, local tooling
.vscode/
.idea/
.claude/
.DS_Store
*.log
*.swp

# Secrets (never commit)
.env
*.pem
*.key
credentials*
*.tfvars

# Large downloads
*.osm.pbf
*.tif
