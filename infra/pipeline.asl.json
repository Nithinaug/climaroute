{
  "Comment": "ClimaRoute shade pipeline: today's sun, shade every tile in parallel, merge",
  "StartAt": "SetSun",
  "States": {
    "SetSun": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${sun_fn}", "Payload.$": "$" },
      "ResultPath": null,
      "Next": "ReadIndex"
    },
    "ReadIndex": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Parameters": { "Bucket": "${bucket}", "Key": "tiles/index.json" },
      "ResultSelector": { "index.$": "States.StringToJson($.Body)" },
      "Next": "ShadeTiles"
    },
    "ShadeTiles": {
      "Type": "Map",
      "ItemsPath": "$.index.tiles",
      "ItemSelector": { "tile_id.$": "$$.Map.Item.Value" },
      "MaxConcurrency": 150,
      "ItemProcessor": {
        "ProcessorConfig": { "Mode": "DISTRIBUTED", "ExecutionType": "EXPRESS" },
        "StartAt": "ShadeTile",
        "States": {
          "ShadeTile": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": { "FunctionName": "${shade_fn}", "Payload.$": "$" },
            "OutputPath": "$.Payload",
            "Retry": [
              {
                "ErrorEquals": ["Lambda.TooManyRequestsException", "Lambda.ServiceException", "Lambda.SdkClientException"],
                "IntervalSeconds": 2,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "End": true
          }
        }
      },
      "ResultPath": null,
      "Next": "Merge"
    },
    "Merge": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": { "FunctionName": "${merge_fn}" },
      "OutputPath": "$.Payload",
      "End": true
    }
  }
}
